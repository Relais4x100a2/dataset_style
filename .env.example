# Copier vers .env et adapter les valeurs (ne jamais committer .env).
# Source unique de paramètres pour `make dev`.
# Si un port est déjà pris sur la machine hôte, change APP_PORT.

# --- App ---
APP_PORT=8501

# --- PostgreSQL ---
POSTGRES_HOST=localhost
# Port utile surtout pour un lancement hors Docker (l'app compose parle à postgres:5432 en interne).
POSTGRES_PORT=5432
POSTGRES_DB=dataset_style
POSTGRES_USER=dataset_user
POSTGRES_PASSWORD=change_me

# --- SuperTokens ---
SUPERTOKENS_HOST=localhost
# Par défaut, SuperTokens partage la même base que l'app pour un setup 1-commande.
SUPERTOKENS_DB=dataset_style
SUPERTOKENS_CORE_API_KEY=change_me_core_key_2026
SUPERTOKENS_API_KEY=change_me_core_key_2026
AUTH_ENFORCE_INVITATION_ONLY=true
SUPERTOKENS_SIGNUP_DISABLED=true
APP_PUBLIC_BASE_URL=http://localhost:8501
SUPER_ADMIN_EMAILS=
ACCOUNT_SAGA_MAX_RETRIES=5

# --- Email ---
MAIL_MODE=dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# --- Optionnel : URL explicites (prioritaires si définies) ---
# DATABASE_URL=postgresql+psycopg://dataset_user:change_me@localhost:5432/dataset_style
# SUPERTOKENS_CONNECTION_URI=http://localhost:3567

# --- Optionnel : fallbacks globaux LLM / LanguageTool ---
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=mistral
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=300
LANGUAGETOOL_BASE_URL=http://localhost:8010
