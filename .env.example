# Copier vers .env et adapter les valeurs (ne jamais committer .env).
# Source unique de paramètres pour `make dev`.
# Si un port est déjà pris sur la machine hôte, change APP_PORT.

# --- App ---
APP_PORT=8501
# Slice vertical FastAPI (issue-007) — même compose que Streamlit
WEBAPP_PORT=8080
WEBAPP_CORS_ORIGINS=http://localhost:8080
# Cibles autorisées après POST /api/auth/signout (réponse ``redirect``) — chemins relatifs, virgules.
WEBAPP_SIGNOUT_REDIRECT_ALLOWLIST=/
# Plafond optionnel du nombre de fiches exportables (CSV/JSONL) — dépassement → HTTP 413 + EXPORT_PAYLOAD_TOO_LARGE.
# WEBAPP_EXPORT_MAX_ROWS=50000
# Mode développement : affiche un panneau « détails techniques » sur erreur BDD au démarrage.
# En production (CapRover), laisser vide ou APP_ENV=production — message utilisateur neutre uniquement.
# APP_ENV=development
# Alternative : SHOW_DB_TECHNICAL_ERRORS=1 (même effet que APP_ENV=development pour ces messages).

# --- PostgreSQL ---
POSTGRES_HOST=localhost
# Port utile surtout pour un lancement hors Docker (l'app compose parle à postgres:5432 en interne).
POSTGRES_PORT=5432
POSTGRES_DB=dataset_style
POSTGRES_USER=dataset_user
POSTGRES_PASSWORD=change_me

# --- SuperTokens ---
SUPERTOKENS_HOST=localhost
# Par défaut, SuperTokens partage la même base que l'app pour un setup 1-commande.
SUPERTOKENS_DB=dataset_style
SUPERTOKENS_CORE_API_KEY=change_me_core_key_2026
SUPERTOKENS_API_KEY=change_me_core_key_2026
AUTH_ENFORCE_INVITATION_ONLY=true
SUPERTOKENS_SIGNUP_DISABLED=true
APP_PUBLIC_BASE_URL=http://localhost:8501
# Texte optionnel (issue-021) — bannière migration dans Streamlit + page d'accueil webapp ; vide = désactivé.
# APP_MIGRATION_INFO_BANNER=Recette : utilisez l'URL préprod pour les tests ; la prod reste une seule URL officielle.
SUPER_ADMIN_EMAILS=
ACCOUNT_SAGA_MAX_RETRIES=5

# --- Email ---
MAIL_MODE=dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# --- Projets / onboarding (issue-008) ---
# Si 1, true, yes ou on : pas de formulaire « créer un projet » pour les utilisateurs sans projet (invitation / admin uniquement).
# DISABLE_SELF_SERVICE_PROJECT_CREATION=true

# --- Optionnel : URL explicites (prioritaires si définies) ---
# DATABASE_URL=postgresql+psycopg://dataset_user:change_me@localhost:5432/dataset_style
# SUPERTOKENS_CONNECTION_URI=http://localhost:3567

# --- Optionnel : fallbacks globaux LLM / LanguageTool ---
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=mistral
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=300
LANGUAGETOOL_BASE_URL=http://localhost:8010
